      "parameters": {
        "jsCode": "// Массив с числами\nconst numbers = [1, 2, 3, 4, 5];\n\n// Объект с информацией\nconst info = {\n    student: \"Кучинская\",\n    lab: \"lab4\",\n    task: \"2.2 Code\"\n};\n\n// Переменная для суммы\nlet sum = 0;\n\n// Цикл for — считаем сумму массива\nfor (let i = 0; i < numbers.length; i++) {\n    sum = sum + numbers[i];\n}\n\n// if/else — определяем категорию\nlet category;\nif (sum > 10) {\n    category = \"большая сумма\";\n} else {\n    category = \"маленькая сумма\";\n}\n\n// Возвращаем объект с полем payload\nreturn {\n    payload: {\n        sum: sum,\n        category: category,\n        arrayLength: numbers.length,\n        info: info,\n        timestamp: new Date().toISOString()\n    }\n};"
      },
