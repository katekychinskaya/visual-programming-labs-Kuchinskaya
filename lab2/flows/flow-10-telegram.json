                "75144a9edc10dc34"
            ]
        ]
    },
    {
        "id": "229b1afb05bf63f2",
        "type": "function",
        "z": "441736a172b31e87",
        "name": "Ответ /start",
        "func": "msg.payload = {\n    chatId: msg.payload.chatId,\n    type: \"message\",\n    content: \"Привет! Я бот студента Кучинской. Мои команды:\\n/start — это сообщение\\n/echo <текст> — повторить текст\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
