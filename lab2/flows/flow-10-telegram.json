    {
        "id": "76b239711a1ba3a4",
        "type": "function",
        "z": "441736a172b31e87",
        "name": "Эхо-ответ",
        "func": "// Убираем \"/echo\" из текста и возвращаем остаток\nconst text = msg.payload.content || \"\";\nconst echo = text.replace(/\\/echo\\s*/i, \"\").trim();\n\nmsg.payload = {\n    chatId: msg.payload.chatId,\n    type: \"message\",\n    content: echo ? \"Ты написал: \" + echo : \"Напиши что-нибудь после /echo, например: /echo Привет\"\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 530,
        "y": 340,
        "wires": [
