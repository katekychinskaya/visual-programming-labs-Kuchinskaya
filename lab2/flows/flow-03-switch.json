    {
        "id": "7d3526a425c2c352",
        "type": "function",
        "z": "28e135d9dcdcfeda",
        "name": "Обработка числа",
        "func": "// Получаем число из inject\nconst inputNumber = msg.payload;\n\n// Массив с числами для примера\nlet numbers = [1, 2, 3, 4, 5];\n\n// Объект с информацией\nconst info = {\n    student: \"Кучинская\",\n    lab: \"lab2\",\n    task: \"2.2 function\"\n};\n\n// Проверяем входное значение через if/else\nlet category;\nif (inputNumber > 3) {\n    category = \"большое\";\n} else {\n    category = \"маленькое\";\n}\n\n// Считаем сумму чисел в массиве через цикл for\nlet sum = 0;\nfor (let i = 0; i < numbers.length; i++) {\n    sum = sum + numbers[i];\n}\n\n// Возвращаем объект с полем payload\nmsg.payload = {\n    input: inputNumber,\n    category: category,\n    arraySum: sum,\n    arrayLength: numbers.length,\n    info: info\n};\n\nreturn msg;",
