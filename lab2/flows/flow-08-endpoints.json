    {
        "id": "07855b8a7d032bcd",
        "type": "function",
        "z": "d552902b2538b99e",
        "name": "Обработать id",
        "func": "// Получаем id из path-параметра\nconst id = msg.req.params.id;\n\n// Проверяем: id должен быть числом 1, 2 или 3\nconst validItems = {\n    \"1\": { name: \"Пицца\", price: 15 },\n    \"2\": { name: \"Суши\", price: 25 },\n    \"3\": { name: \"Бургер\", price: 10 }\n};\n\nif (validItems[id]) {\n    // Успешный ответ\n    msg.statusCode = 200;\n    msg.payload = {\n        success: true,\n        item: validItems[id]\n    };\n} else {\n    // Товар не найден → 404\n    msg.statusCode = 404;\n    msg.payload = {\n        success: false,\n        error: \"Товар с id=\" + id + \" не найден\"\n    };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
